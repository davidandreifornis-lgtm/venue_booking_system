<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
        <add value="index.php" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <!-- /api/* → backend/api/index.php -->
        <rule name="VenueBooking API" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="backend/api/index.php" appendQueryString="true" />
        </rule>
        <!-- Direct health.php still works if requested -->
      </rules>
    </rewrite>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
